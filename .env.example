# --- Database ---
DATABASE_URL=postgres://feedbackhub:feedbackhub@postgres:5432/feedbackhub
POSTGRES_USER=feedbackhub
POSTGRES_PASSWORD=feedbackhub
POSTGRES_DB=feedbackhub

# --- Auth secrets (generate strong random values in production) ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
SESSION_SECRET=change-me-session-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- URLs ---
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
SDK_URL=http://localhost:4000/sdk.js
DEMO_URL=http://localhost:3001

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Redis (optional, used for rate limiting/caching if present) ---
REDIS_URL=redis://redis:6379

# --- Email (optional, used for password reset / verification) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FeedbackHub <no-reply@feedbackhub.local>

# --- Misc ---
NODE_ENV=development
PORT=4000
